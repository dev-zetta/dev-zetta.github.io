---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Gabriel Max"
  description="The requested portfolio page could not be found."
  canonicalPath="/404"
>
  <main class="not-found" id="main-content">
    <p class="eyebrow">Error 404</p>
    <h1>That path is outside the build.</h1>
    <p>
      The portfolio is a focused, single-page record of verified public
      engineering work.
    </p>
    <a class="button button--primary" href="/">Return to the portfolio</a>
  </main>
</BaseLayout>
